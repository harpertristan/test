{
  "name": "registration-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=2",
    "check": "node --check server.js && node --check public/app.js && node --check extension/panel.js && node --check extension/background.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "mammoth": "1.13.0",
    "multer": "2.5.0",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "jszip": "3.10.2"
  }
}
