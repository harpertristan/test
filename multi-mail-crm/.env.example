# Copy to .env; replace placeholders before starting. Never commit .env.
POSTGRES_USER=crm
POSTGRES_DB=crm
# URL-safe password, at least 24 random characters
POSTGRES_PASSWORD=replace-with-random-url-safe-password
JWT_SECRET=replace-with-at-least-32-random-characters
FERNET_KEY=replace-with-generated-fernet-key
PUBLIC_URL=http://localhost:3000
APP_BASE_PATH=/mail-crm
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ORGANIZATION_ID=
ZOHO_API_BASE=https://mail.zoho.eu/api
ZOHO_TOKEN_URL=https://accounts.zoho.eu/oauth/v2/token
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLASSIFIER_BACKEND=openai
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
IMAP_MAX_CONNECTIONS=8
SYNC_INTERVAL_SECONDS=120
ZOHO_REQUESTS_PER_MINUTE=30
LLM_REQUESTS_PER_MINUTE=60

# Application settings
SYNC_BATCH_SIZE=25
INITIAL_SYNC_DAYS=30
MAX_MESSAGE_BYTES=10485760
LOG_LEVEL=INFO

# DATABASE_URL is assembled by Compose from POSTGRES_*; local Python outside Docker must set it explicitly.
